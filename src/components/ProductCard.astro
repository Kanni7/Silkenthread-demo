---
// Product card. Markup lives in src/lib/card.js so client-side filtering renders identical cards.
import { cardHtml } from '../lib/card.js';
import { summary } from '../lib/data.js';
// clone: decorative duplicate for a looping marquee, hidden from assistive tech and keyboard (inert).
const { product, sectionId, sizes, cardClass, ratioStyle, lazy = true, itemClass, itemId, clone = false } = Astro.props;
const attrs = (itemId ? ` id="${itemId}"` : '') + (clone ? ' aria-hidden="true" inert' : '');
const html = cardHtml(summary(product), { sectionId, sizes, cardClass, ratioStyle, lazy, itemClass, itemAttrs: attrs });
---
<Fragment set:html={html} />
