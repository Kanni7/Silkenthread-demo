---
// Craft header: mobile drawer (header-drawer), logo, inline dropdown menus, localization, search, account, cart.
// Menu content comes from src/data/menu.json, so one edit updates every page.
import Icon from './Icon.astro';
import Section from './Section.astro';
import SearchModal from './SearchModal.astro';
import Localization from './Localization.astro';
import { menu, templates, imageUrl, imageSrcset, localHref } from '../lib/data.js';

interface Props { isHome?: boolean }
const { isHome = false } = Astro.props;
const h = templates.groups.header;
const path = Astro.url.pathname.replace(/\.html$/, '');
const slug = (s) => s.toLowerCase().replace(/&/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const isActive = (href) => href && localHref(href) === path;
const items = menu.main.map((item, i) => ({ ...item, n: i + 1, slug: slug(item.label), href: item.href && localHref(item.href), childActive: (item.children || []).some((c) => isActive(c.href)) }));
const logo = menu.logo;
---
<Section id={h.id} class={h.class} style={h.style}>
  <div class={h.wrapper}>
    <header class={h.header}>
      <header-drawer data-breakpoint="tablet">
        <details id="Details-menu-drawer-container" class="menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="Menu" role="button" aria-expanded="false" aria-controls="menu-drawer">
            <span><Icon name="hamburger" /><Icon name="close" /></span>
          </summary>
          <div id="menu-drawer" class={h.drawer}>
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation" aria-label="Main menu">
                  <ul class="menu-drawer__menu has-submenu list-menu" role="list">
                    {items.map((item) => (
                      <li>
                        {item.children ? (
                          <details id={`Details-menu-drawer-menu-item-${item.n}`}>
                            <summary id={`HeaderDrawer-${item.slug}`} class="menu-drawer__menu-item list-menu__item link link--text focus-inset" role="button" aria-expanded="false" aria-controls={`link-${item.slug}`}>
                              {item.label}
                              <Icon name="arrow" />
                              <Icon name="caret" />
                            </summary>
                            <div id={`link-${item.slug}`} class={h.drawerSubmenu} tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button type="button" class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                  <Icon name="arrow" />
                                  {item.label}
                                </button>
                                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                  {item.children.map((c) => (
                                    <li>
                                      <a id={`HeaderDrawer-${item.slug}-${slug(c.label)}`} href={localHref(c.href)} class:list={['menu-drawer__menu-item link link--text list-menu__item focus-inset', { 'menu-drawer__menu-item--active': isActive(c.href) }]} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            </div>
                          </details>
                        ) : (
                          <a id={`HeaderDrawer-${item.slug}`} href={item.href} class:list={['menu-drawer__menu-item list-menu__item link link--text focus-inset', { 'menu-drawer__menu-item--active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                        )}
                      </li>
                    ))}
                  </ul>
                </nav>
                <div class="menu-drawer__utility-links">
                  <a href="/account/login" class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide">
                    <Icon name="account" />
                    Log in
                  </a>
                  <div class="menu-drawer__localization header-localization">
                    <Localization idPrefix="HeaderCountryMobile" />
                  </div>
                  <ul class="list list-social list-unstyled" role="list">
                    {h.social.map((s) => (
                      <li class="list-social__item">
                        <a href={s.href} class="list-social__link link" rel="noopener" target="_blank"><Icon name={s.icon} /><span class="visually-hidden">{s.label}</span></a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </details>
      </header-drawer>

      <SearchModal inputId="Search-In-Modal-1" />

      {isHome ? (
        <h1 class="header__heading">
          <a href="/" class="header__heading-link link link--text focus-inset">
            <div class="header__heading-logo-wrapper">
              <img src={imageUrl(logo, 600)} srcset={imageSrcset(logo, [290, 580])} alt={logo.alt || logo.text} width={h.logoWidth} height={Math.round(h.logoHeight)} loading="eager" class="header__heading-logo motion-reduce" sizes={`(max-width: ${h.logoWidth * 2}px) 50vw, ${h.logoWidth}px`} />
            </div>
          </a>
        </h1>
      ) : (
        <a href="/" class="header__heading-link link link--text focus-inset">
          <div class="header__heading-logo-wrapper">
            <img src={imageUrl(logo, 600)} srcset={imageSrcset(logo, [290, 580])} alt={logo.alt || logo.text} width={h.logoWidth} height={Math.round(h.logoHeight)} loading="eager" class="header__heading-logo motion-reduce" sizes={`(max-width: ${h.logoWidth * 2}px) 50vw, ${h.logoWidth}px`} />
          </div>
        </a>
      )}

      <nav class="header__inline-menu" aria-label="Main menu">
        <ul class="list-menu list-menu--inline" role="list">
          {items.map((item) => (
            <li>
              {item.children ? (
                <header-menu>
                  <details id={`Details-HeaderMenu-${item.n}`}>
                    <summary id={`HeaderMenu-${item.slug}`} class="header__menu-item list-menu__item link focus-inset" role="button" aria-expanded="false" aria-controls={`HeaderMenu-MenuList-${item.n}`}>
                      <span class:list={{ 'header__active-menu-item': item.childActive }}>{item.label}</span>
                      <Icon name="caret" />
                    </summary>
                    <ul id={`HeaderMenu-MenuList-${item.n}`} class={h.dropdown} role="list" tabindex="-1">
                      {item.children.map((c) => (
                        <li>
                          <a id={`HeaderMenu-${item.slug}-${slug(c.label)}`} href={localHref(c.href)} class:list={['header__menu-item list-menu__item link link--text focus-inset caption-large', { 'list-menu__item--active': isActive(c.href) }]} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </header-menu>
              ) : (
                <a id={`HeaderMenu-${item.slug}`} href={item.href} class:list={['header__menu-item list-menu__item link link--text focus-inset', { 'header__menu-item--active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span class:list={{ 'header__active-menu-item': isActive(item.href) }}>{item.label}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="header__icons header__icons--localization header-localization">
        <div class="desktop-localization-wrapper">
          <Localization idPrefix="HeaderCountry" class="small-hide medium-hide" />
        </div>
        <SearchModal inputId="Search-In-Modal" />
        <a href="/account/login" class="header__icon header__icon--account link focus-inset small-hide">
          <Icon name="account" />
          <span class="visually-hidden">Log in</span>
        </a>
        <a href="/cart" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
          <Icon name="cart-empty" />
          <span class="visually-hidden">Cart</span>
        </a>
      </div>
    </header>
  </div>
</Section>
<script>
  import '../scripts/header.js';
</script>
