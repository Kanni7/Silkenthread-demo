---
// Blog article (Craft main-article + newsletter sections): title, date, body, share, back link,
// comment form (front-end mock: nothing is posted).
import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import Icon from '../../../components/Icon.astro';
import blogs from '../../../data/blogs.json';
import { localizeHtml, imageUrl, imageSrcset } from '../../../lib/data.js';

export function getStaticPaths() {
  return Object.values(blogs).flatMap((b) => b.articles.map((a) => ({ params: { blog: b.handle, article: a.handle }, props: { blog: b, article: a } })));
}
const { blog, article: a } = Astro.props;
const id = 'template--17223805436148__main';
const nl = 'template--17223805436148__newsletter';
const nlStyle = `.section-${nl}-padding { padding-top: 30px; padding-bottom: 30px; } @media screen and (min-width: 750px) { .section-${nl}-padding { padding-top: 40px; padding-bottom: 40px; } }`;
---
<Base title={a.metaTitle || `${a.title} – Silkenthread.in`} description={a.metaDescription}>
  <Section id={id} tag="section">
    <article class="article-template">
      {a.image && (
        <div class="article-template__hero-container">
          <div class="article-template__hero-medium media" style={`padding-bottom: ${(100 * (a.image.height || 1)) / (a.image.width || 1)}%;`}>
            <img srcset={imageSrcset(a.image, [350, 750, 1100, 1500, 2200, 3000])} src={imageUrl(a.image, 1100)} sizes="(min-width: 1200px) 1100px, (min-width: 750px) calc(100vw - 10rem), 100vw" alt={a.image.alt || ''} width={a.image.width || 1100} height={a.image.height || 1100} />
          </div>
        </div>
      )}
      <header class="page-width page-width--narrow">
        <h1 class="article-template__title">{a.title}</h1>
        {a.date && <span class="circle-divider caption-with-letter-spacing"><time datetime={a.date}>{a.dateLabel}</time></span>}
      </header>
      <div class="article-template__content page-width page-width--narrow rte" set:html={localizeHtml(a.html)} />
      <div class="article-template__social-sharing page-width page-width--narrow">
        <share-button class="share-button quick-add-hidden" data-url={`https://silkenthread.in${a.url}`}>
          <button class="share-button__button" type="button" data-share><Icon name="share" />Share</button>
          <span class="share-button__message hidden" role="status"></span>
        </share-button>
      </div>
      <div class="article-template__back element-margin-top center">
        <a href={blog.url} class="article-template__link link animate-arrow"><span class="icon-wrap"><Icon name="arrow" /></span>Back to blog</a>
      </div>
      <div class="article-template__comment-wrapper background-secondary">
        <div id="comments" class="page-width page-width--narrow">
          <form id="comment_form" class="comment-form" data-mock-form novalidate>
            <h2>Leave a comment</h2>
            <div>
              <div class="article-template__comment-fields">
                <div class="field field--with-error">
                  <input type="text" name="comment[author]" id="CommentForm-author" class="field__input" autocomplete="name" aria-required="true" required placeholder="Name" />
                  <label class="field__label" for="CommentForm-author">Name <span aria-hidden="true">*</span></label>
                </div>
                <div class="field field--with-error">
                  <input type="email" name="comment[email]" id="CommentForm-email" autocomplete="email" class="field__input" autocorrect="off" autocapitalize="off" aria-required="true" required placeholder="Email" />
                  <label class="field__label" for="CommentForm-email">Email <span aria-hidden="true">*</span></label>
                </div>
              </div>
              <div class="field field--with-error">
                <textarea rows="5" name="comment[body]" id="CommentForm-body" class="text-area field__input" aria-required="true" required placeholder="Comment"></textarea>
                <label class="form__label field__label" for="CommentForm-body">Comment <span aria-hidden="true">*</span></label>
              </div>
            </div>
            <p class="article-template__comment-warning caption">Please note, comments need to be approved before they are published.</p>
            <input type="submit" class="button" value="Post comment" />
            <p class="concept-notice" hidden>Thanks! This is a design concept, so comments aren't sent anywhere.</p>
          </form>
        </div>
      </div>
    </article>
  </Section>
  <Section id={nl} tag="section" style={nlStyle}>
    <div class="newsletter center">
      <div class={`newsletter__wrapper color-accent-1 gradient content-container isolate content-container--full-width section-${nl}-padding`}>
        <h2 class="inline-richtext h1">Subscribe to our emails</h2>
        <div class="newsletter__subheading rte"><p>Subscribe to our mailing list for insider news, product launches, and more.</p></div>
        <div>
          <form class="newsletter-form" data-mock-form novalidate>
            <div class="newsletter-form__field-wrapper">
              <div class="field">
                <input id={`NewsletterForm--${nl}`} type="email" name="contact[email]" class="field__input" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="Email" required />
                <label class="field__label" for={`NewsletterForm--${nl}`}>Email</label>
                <button type="submit" class="newsletter-form__button field__button" aria-label="Subscribe"><Icon name="arrow" /></button>
              </div>
            </div>
            <p class="concept-notice" hidden>Thanks! This is a design concept, so no email is stored or sent.</p>
          </form>
        </div>
      </div>
    </div>
  </Section>
</Base>
<script>
  // Share: native share sheet where available, otherwise copy the live article URL.
  document.querySelectorAll<HTMLElement>('share-button [data-share]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const el = btn.closest('share-button') as HTMLElement;
      const url = el.dataset.url!;
      const msg = el.querySelector('.share-button__message')!;
      if (navigator.share) { try { await navigator.share({ url, title: document.title }); return; } catch {} }
      try { await navigator.clipboard.writeText(url); msg.textContent = 'Link copied to clipboard!'; } catch { msg.textContent = url; }
      msg.classList.remove('hidden');
    }),
  );
</script>
