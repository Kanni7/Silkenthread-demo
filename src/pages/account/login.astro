---
// Account login: not part of the concept (no customer accounts); points to the live store.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
---
<Base title="Account – Silkenthread.in">
  <Section id="main-login" class="shopify-section section">
    <div class="customer login page-width page-width--narrow st-account">
      <h1>Login</h1>
      <p class="concept-notice">Customer accounts aren't part of this design concept. To sign in, use <a href="https://silkenthread.in/account/login" class="link underlined-link" rel="noopener">silkenthread.in</a>.</p>
    </div>
  </Section>
</Base>
